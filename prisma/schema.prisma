generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  aiWorkers    AIWorker[]
  purchases    Purchase[]
  reviews      Review[]
  payouts      Payout[]
  makerProfile MakerProfile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MakerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?
  expertise   String?
  website     String?
  bankAccount String?
  totalEarned Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIWorker {
  id             String    @id @default(cuid())
  makerId        String
  title          String
  description    String
  category       String
  aiProvider     String    @default("openai")
  aiModel        String    @default("gpt-4o-mini")
  isAiConfigPublic Boolean @default(false)
  roleDefinition String
  workflow       String
  prompt         String
  rules          String?
  outputFormat   String?
  datasetRefs    String?
  price          Float     @default(0)
  priceType      String    @default("one_time")
  status         String    @default("draft")
  version        String    @default("1.0.0")
  thumbnail      String?
  tags           String?
  totalSales     Int       @default(0)
  totalViews     Int       @default(0)
  avgRating      Float     @default(0)
  reviewCount    Int       @default(0)
  rejectionNote  String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  maker        User          @relation(fields: [makerId], references: [id])
  purchases    Purchase[]
  reviews      Review[]
  executions   Execution[]
  adminReviews AdminReview[]
}

model AdminReview {
  id         String   @id @default(cuid())
  workerId   String
  reviewerId String
  score      Float?
  note       String?
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  worker AIWorker @relation(fields: [workerId], references: [id])
}

model Purchase {
  id              String    @id @default(cuid())
  userId          String
  workerId        String
  amount          Float
  paymentMethod   String    @default("stripe")
  paymentId       String?
  paymentStatus   String    @default("pending")
  subscriptionId  String?
  subscriptionEnd DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User     @relation(fields: [userId], references: [id])
  worker AIWorker @relation(fields: [workerId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  workerId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User     @relation(fields: [userId], references: [id])
  worker AIWorker @relation(fields: [workerId], references: [id])

  @@unique([userId, workerId])
}

model Execution {
  id        String   @id @default(cuid())
  workerId  String
  userId    String?
  provider  String?
  model     String?
  input     String
  output    String?
  status    String   @default("pending")
  error     String?
  tokens    Int?
  duration  Int?
  createdAt DateTime @default(now())

  worker AIWorker @relation(fields: [workerId], references: [id])
}

model Payout {
  id        String   @id @default(cuid())
  makerId   String
  amount    Float
  status    String   @default("pending")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maker User @relation(fields: [makerId], references: [id])
}

model AIProviderKey {
  id        String   @id @default(cuid())
  provider  String   @unique
  apiKey    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
